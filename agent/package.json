{
  "name": "aura-print-pro-agent",
  "version": "1.0.0",
  "description": "Native Windows background print agent daemon for AURA Print Pro counter automation",
  "main": "print-agent.js",
  "author": "Sabir Ansari",
  "license": "PROPRIETARY",
  "private": true,
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node print-agent.js",
    "install-service": "node install-service.js",
    "uninstall-service": "node uninstall-service.js",
    "test-hardware": "node -e \"require('./print-agent.js')\"",
    "build:exe": "pkg print-agent.js --targets node18-win-x64 --output dist/AuraPrintProAgent.exe"
  },
  "dependencies": {
    "node-windows": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "print-agent.js"
    ],
    "assets": [
      "config.json"
    ],
    "outputPath": "dist"
  }
}
